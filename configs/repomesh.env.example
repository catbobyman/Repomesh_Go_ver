# Documentation only: binaries do not automatically load .env files.
# Relative paths are resolved from the current working directory.
REPOMESH_WEB_ADDR=127.0.0.1:8080
REPOMESH_WEB_ASSETS=web/dist

# Used only by explicit repomesh-web db check / db migrate commands.
# Set a real development connection string in the process environment.
# REPOMESH_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE?sslmode=disable
