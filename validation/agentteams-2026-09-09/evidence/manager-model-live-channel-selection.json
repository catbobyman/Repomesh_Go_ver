        {
          "line": 122,
          "text": "def get_channel_registry() -> dict[str, type[BaseChannel]]:"
        },
        {
          "line": 123,
          "text": "    \"\"\"Built-in + plugin-registered channels.\"\"\""
        },
        {
          "line": 124,
          "text": "    out = _get_cached_builtin_channels()"
        },
        {
          "line": 125,
          "text": "    for key, ch_cls in _get_plugin_channels().items():"
        },
        {
          "line": 126,
          "text": "        if key in out:"
        },
        {
          "line": 127,
          "text": "            logger.warning("
        },
        {
          "line": 128,
          "text": "                \"Plugin channel '%s' skipped: key already exists in \""
        },
        {
          "line": 129,
          "text": "                \"built-in channels\","
        },
        {
          "line": 130,
          "text": "                key,"
        },
        {
          "line": 131,
          "text": "            )"
        },
        {
          "line": 132,
          "text": "            continue"
        },
        {
          "line": 133,
          "text": "        out[key] = ch_cls"
        },
        {
          "line": 134,
          "text": "    return out"
        }
      ]
