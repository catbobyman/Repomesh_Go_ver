        {
          "line": 433,
          "text": "    }"
        },
        {
          "line": 434,
          "text": "    if history_limit is not None:"
        },
        {
          "line": 435,
          "text": "        matrix_channel_cfg[\"history_limit\"] = int(history_limit)"
        },
        {
          "line": 436,
          "text": "    if user_id:"
