    {
      "path": "/opt/agentteams/scripts/init/start-qwenpaw-manager.sh",
      "sha256": "4194264ed8857084963a0b7efedd3b168cc63879cb103b6be38f0251d74cd92c",
      "excerpts": [
        {
          "line": 79,
          "text": "log \"Config bridged from openclaw.json\""
        },
        {
          "line": 80,
          "text": ""
        },
        {
          "line": 81,
          "text": "# ============================================================"
        },
        {
          "line": 82,
          "text": "# 3. Sync prompt files into CoPaw paths"
        },
        {
          "line": 83,
          "text": "# ============================================================"
        },
        {
          "line": 298,
          "text": "# 10. Copy AgentTeams plugins into working dir"
        },
        {
          "line": 299,
          "text": "# ============================================================"
        },
        {
          "line": 300,
          "text": "# The Dockerfile copies plugins to /opt/agentteams/plugins/ (image-local)."
        },
        {
          "line": 301,
          "text": "# /root/manager-workspace is a host-mounted volume at runtime, so"
        },
        {
          "line": 302,
          "text": "# build-time files there are hidden. Copy plugins to the QwenPaw"
        },
        {
          "line": 303,
          "text": "# working dir's plugins/ directory before startup so PluginLoader"
        },
        {
          "line": 304,
          "text": "# discovers them."
        },
        {
          "line": 305,
          "text": "PLUGINS_TARGET=\"${QWENPAW_WORKING_DIR}/plugins\""
        },
        {
          "line": 306,
          "text": "mkdir -p \"${PLUGINS_TARGET}\""
        },
        {
          "line": 307,
          "text": "for _plugin_src in /opt/agentteams/plugins/*/; do"
        },
        {
          "line": 308,
          "text": "    _plugin_name=$(basename \"${_plugin_src}\")"
        },
        {
          "line": 309,
          "text": "    if [ -f \"${_plugin_src}plugin.json\" ]; then"
        },
        {
          "line": 310,
          "text": "        rm -rf \"${PLUGINS_TARGET}/${_plugin_name}\""
        },
        {
          "line": 311,
          "text": "        cp -a \"${_plugin_src}\" \"${PLUGINS_TARGET}/${_plugin_name}\""
        },
        {
          "line": 312,
          "text": "        log \"Installed plugin: ${_plugin_name}\""
        },
        {
          "line": 313,
          "text": "    fi"
        },
        {
          "line": 314,
          "text": "done"
        },
        {
          "line": 315,
          "text": ""
        },
        {
          "line": 316,
          "text": "# ============================================================"
        }
      ],
      "matches_locked_upstream_sha256": true
