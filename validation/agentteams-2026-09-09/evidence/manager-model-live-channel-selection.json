        },
        {
          "line": 438,
          "text": ""
        },
        {
          "line": 439,
          "text": "    config_path = working_dir / \"config.json\""
        },
        {
          "line": 440,
          "text": "    # Merge with existing config to avoid clobbering other settings"
        },
        {
          "line": 441,
          "text": "    existing: dict[str, Any] = {}"
        },
        {
          "line": 442,
          "text": "    if config_path.exists():"
        },
        {
          "line": 443,
          "text": "        with open(config_path) as f:"
