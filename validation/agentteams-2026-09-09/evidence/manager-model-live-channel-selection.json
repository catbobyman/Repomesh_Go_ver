          "line": 548,
          "text": "    matrix_ch[\"groups\"] = groups"
        },
        {
          "line": 549,
          "text": "    matrix_ch[\"filter_tool_messages\"] = True"
        },
        {
          "line": 550,
          "text": "    matrix_ch[\"filter_thinking\"] = True"
