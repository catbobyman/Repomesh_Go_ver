        "line": 3606,
        "text": "        meta: Optional[Dict[str, Any]],"
      },
      {
        "line": 3607,
        "text": "    ) -> None:"
      },
      {
        "line": 3608,
        "text": "        \"\"\"Attach Matrix thread relation metadata to an outgoing event."
      },
      {
        "line": 3609,
        "text": ""
      },
      {
        "line": 3610,
        "text": "        Only applies when an explicit thread context has been established"
      },
      {
        "line": 3611,
        "text": "        (by _with_thread_relation_meta or _ensure_thread_root). The inbound"
      },
      {
        "line": 3612,
        "text": "        _THREAD_META_ROOT_KEY alone is NOT sufficient — it is always present"
      },
      {
        "line": 3613,
        "text": "        from the original sender's event_id and would incorrectly thread"
      },
      {
        "line": 3614,
        "text": "        every reply under the sender's message."
      },
      {
        "line": 3615,
        "text": "        \"\"\""
      },
      {
        "line": 3616,
        "text": "        if not isinstance(content, dict) or not isinstance(meta, dict):"
      },
      {
        "line": 3617,
        "text": "            return"
      },
      {
        "line": 3618,
        "text": "        thread_root = ("
      },
      {
        "line": 3619,
        "text": "            meta.get(_MATRIX_THREAD_META_KEY)"
      },
      {
        "line": 3620,
        "text": "            or meta.get(_MATRIX_OWN_THREAD_ROOT_KEY)"
      },
      {
        "line": 3621,
        "text": "        )"
      },
      {
        "line": 3622,
        "text": "        if not thread_root:"
      },
      {
        "line": 3623,
        "text": "            return"
      },
      {
        "line": 3624,
        "text": "        content[\"m.relates_to\"] = {"
      },
      {
        "line": 3625,
        "text": "            \"rel_type\": \"m.thread\","
      },
      {
        "line": 3626,
        "text": "            \"event_id\": thread_root,"
      },
      {
        "line": 3627,
        "text": "            \"is_falling_back\": False,"
      },
      {
        "line": 3628,
        "text": "        }"
