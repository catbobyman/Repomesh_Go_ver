        "line": 3151,
        "text": "    def to_handle_from_target(self, *, user_id: str, session_id: str) -> str:"
      },
      {
        "line": 3152,
        "text": "        \"\"\"For Matrix, return room_id (session_id), not user_id."
      },
      {
        "line": 3153,
        "text": ""
      },
      {
        "line": 3154,
        "text": "        Matrix requires room_id to send messages, not user_id."
      },
      {
        "line": 3155,
        "text": "        Override BaseChannel's default implementation which returns user_id."
      },
      {
        "line": 3358,
        "text": "    def _is_thread_event(self, event: Any) -> bool:"
      },
      {
        "line": 3359,
        "text": "        \"\"\"Return True when an inbound Matrix event belongs to a thread.\"\"\""
      },
      {
        "line": 3360,
        "text": "        source = getattr(event, \"source\", {}) or {}"
      },
      {
        "line": 3361,
        "text": "        if not isinstance(source, dict):"
      },
      {
        "line": 3362,
        "text": "            return False"
      },
      {
        "line": 3363,
        "text": "        content = source.get(\"content\", {}) or {}"
      },
      {
        "line": 3364,
        "text": "        if not isinstance(content, dict):"
      },
      {
        "line": 3365,
        "text": "            return False"
      },
      {
        "line": 3366,
        "text": "        relates_to = content.get(\"m.relates_to\", {}) or {}"
      },
      {
        "line": 3367,
        "text": "        if not isinstance(relates_to, dict):"
      },
      {
        "line": 3368,
        "text": "            return False"
      },
      {
        "line": 3369,
        "text": "        return relates_to.get(\"rel_type\") == \"m.thread\""
      },
      {
        "line": 3370,
        "text": ""
      },
      {
        "line": 3603,
        "text": "    def _apply_thread_relation("
      },
      {
        "line": 3604,
        "text": "        self,"
      },
