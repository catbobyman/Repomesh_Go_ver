        "620:     return provider_info",
        "621: ",
        "622: ",
        "623: @router.get(",
        "624:     \"/active\",",
        "625:     response_model=ActiveModelsInfo,",
        "626:     summary=\"Get effective active LLM\",",
        "627: )",
        "628: async def get_active_models(",
        "629:     request: Request,",
        "630:     manager: ProviderManager = Depends(get_provider_manager),",
        "631:     scope: ActiveModelReadScope = Query(default=\"effective\"),",
        "632:     agent_id: Optional[str] = Query(default=None),",
        "633: ) -> ActiveModelsInfo:",
        "634:     \"\"\"Get active model by scope.",
        "635: ",
        "636:     - effective: agent-specific first, otherwise global fallback",
        "637:     - global: ProviderManager global model only",
        "638:     - agent: a specific agent's configured model only",
        "639:     \"\"\"",
        "640:     if scope == \"global\":",
        "641:         return _active_models_info(manager, manager.get_active_model())",
        "642: ",
        "643:     if scope == \"agent\":",
        "644:         if not agent_id:",
        "645:             raise HTTPException(",
        "646:                 status_code=400,",
        "647:                 detail=\"agent_id is required when scope is 'agent'\",",
        "648:             )",
        "649:         return _active_models_info(",
        "650:             manager,",
        "651:             await _load_agent_model(request, agent_id),",
        "652:         )",
        "653: ",
        "654:     try:",
        "655:         target_agent_id = agent_id",
        "656:         if target_agent_id is None:",
        "657:             workspace = await get_agent_for_request(request)",
        "658:             target_agent_id = workspace.agent_id",
        "659: ",
        "660:         agent_model = await _load_agent_model(request, target_agent_id)",
        "661:         if agent_model:",
        "662:             logger.info(",
        "663:                 \"Returning agent-specific model for %s: %s\",",
        "664:                 target_agent_id,",
        "665:                 agent_model,",
        "666:             )",
        "667:             return _active_models_info(manager, agent_model)",
        "668:     except (",
        "669:         HTTPException,",
        "670:         OSError,",
        "671:         ValueError,",
        "672:         TypeError,",
        "673:         AppBaseException,",
        "674:     ) as exc:",
        "675:         logger.warning(",
        "676:             \"Failed to get agent-specific model: %s\",",
        "677:             exc,",
        "678:             exc_info=True,",
        "679:         )",
        "680: ",
        "681:     global_model = manager.get_active_model()",
        "682:     logger.info(\"Returning global model: %s\", global_model)",
        "683:     return _active_models_info(manager, global_model)"
      ]
